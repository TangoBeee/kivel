APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_PASSWORD=generate-with-setup-env
APP_DATABASE_PASSWORD=generate-with-setup-env
DOMAIN=socket.help
PROXY_NETWORK_PREFIX=10.203.0
LOG_LEVEL=info
AUTH_SECRET=generate-with-setup-env
SSH_PORT=2222
SSH_PUBLIC_PORT=2222
SSH_BIND_ADDRESS=127.0.0.1
# Free open beta: keep billing disabled. Leave Dodo credentials empty.
BILLING_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_TEAM_PRODUCT_ID=

# Configure transactional SMTP before a public deployment.
# support@socket.help must also be a working mailbox or forwarded address.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Behind Cloudflare (proxied DNS): trust only its published ranges and read the client IP from its header.
# Ranges: https://www.cloudflare.com/ips/  Leave unset when visitors connect to Caddy directly.
# TRUSTED_PROXY_RANGES=173.245.48.0/20 103.21.244.0/22 ...
# CLIENT_IP_HEADER=CF-Connecting-IP
