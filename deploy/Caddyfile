{
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write 60s
			idle 60s
		}
		max_header_size 16KiB
		# Behind a CDN such as Cloudflare, set TRUSTED_PROXY_RANGES to its published ranges and
		# CLIENT_IP_HEADER to its client header (CF-Connecting-IP). Requests from anywhere else
		# cannot choose their client IP. The defaults trust nothing extra.
		trusted_proxies static {$TRUSTED_PROXY_RANGES:127.0.0.1/32}
		client_ip_headers {$CLIENT_IP_HEADER:X-Forwarded-For}
		trusted_proxies_strict
	}
}

(kivel_transport) {
	transport http {
		dial_timeout 5s
		response_header_timeout 35s
		max_conns_per_host 512
	}
}

(kivel_upstream) {
	reverse_proxy app:3000 {
		import kivel_transport
		# The app sees one address: the verified client, never a chain it has to trust.
		header_up X-Forwarded-For {client_ip}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN}, app.{$DOMAIN} {
	encode zstd gzip
	# The MCP tool page moved when socket.help became Kivel.
	redir /tools/socket-help-mcp/ /tools/kivel-mcp/ permanent
	@uploads {
		method POST
		path /api/files
	}
	@utilities {
		method POST
		path /api/tools/*/run /mcp
	}
	handle @utilities {
		request_body {
			max_size 16777216
		}
		import kivel_upstream
	}
	handle @uploads {
		request_body {
			max_size 10485760
		}
		import kivel_upstream
	}
	@inbound_mail path /hooks/email
	handle @inbound_mail {
		request_body {
			max_size 8388608
		}
		import kivel_upstream
	}
	@authenticator_import {
		method POST
		path /api/authenticators
	}
	handle @authenticator_import {
		request_body {
			max_size 1500000
		}
		import kivel_upstream
	}
	@email path /api/email-inboxes/*/send
	handle @email {
		request_body {
			max_size 1048576
		}
		import kivel_upstream
	}
	handle {
		request_body {
			max_size 102400
		}
		import kivel_upstream
	}
}
