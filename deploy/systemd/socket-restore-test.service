[Unit]
Description=Restore latest Kivel off-site backup in an isolated database
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/socket-help
EnvironmentFile=/opt/socket-help/.ops.env
ExecStart=/usr/bin/node scripts/restore-offsite.mjs
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
