{
  "name": "kivel",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:packages && pnpm --filter frontend build && pnpm --filter frontend test:pages && pnpm --filter backend build",
    "start": "pnpm --filter backend start",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "node scripts/test-postgres.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:https": "node scripts/test-https.mjs",
    "scan:images": "node scripts/scan-images.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "build:packages": "pnpm --filter @kivel/tools build && pnpm --filter @kivel/sdk build && pnpm --filter @kivel/cli build",
    "cli": "node packages/cli/dist/cli.js",
    "backup": "node scripts/backup.mjs",
    "test:backup": "node scripts/verify-backup.mjs",
    "check:production": "node scripts/production-check.mjs",
    "test:packages": "node scripts/test-packages.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm test:packages",
    "test:releases": "node scripts/test-client-releases.mjs",
    "test:agent-mail": "node scripts/test-agent-mail.mjs",
    "test:operations": "node scripts/test-operations.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10"
  }
}
